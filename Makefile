UV = uv
DOCS_FORMAT = google

# Documentation site (Quarto, site/ -> site/_site/): the guide in English and
# Spanish, plus the API reference generated by pdoc under api/.
# quarto render rebuilds _site from scratch, so pdoc runs after it.
.PHONY: docs docs-preview
docs:
	quarto render site
	$(UV) run pdoc --mermaid --math banners -o site/_site/api --docformat $(DOCS_FORMAT)

# Live preview of the guide while writing (without the API reference).
docs-preview:
	quarto preview site

# Checks required by the milestone workflow before any work is reported as done.
.PHONY: lint test check
lint:
	$(UV) run ruff check banners tests scripts

# Tests marked manim are skipped by default (see pyproject.toml).
test:
	$(UV) run pytest

check: lint test

# README images (template gallery PNGs and showcase GIFs) in media/.
# Needs the dev extra; downloads Chromium the first time.
.PHONY: readme-images
readme-images:
	$(UV) run playwright install chromium
	$(UV) run python scripts/readme_images.py

# Pictures of the documentation site (site/images/): still slides and recorded
# animations, plus a copy of the README media. Needs the dev extra and manim.
.PHONY: docs-images
docs-images:
	$(UV) run playwright install chromium
	$(UV) run python scripts/docs_images.py

# Development environment exactly as pinned in uv.lock.
uv-dev:
	$(UV) sync --extra dev

# Manual fallback: releases normally go through .github/workflows/release.yml when a
# vX.Y.Z tag is pushed. This target uploads from the local machine and needs a PyPI token.
.PHONY: publish
publish:
	rm -rf dist/
	$(UV) build
	$(UV) publish
